# Required for live local-harness and bare-baseline calls.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Required for live question generation, answer judging, and patch generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Local client target. Port 8001 is the default cloud service.
ANTIGRAVITY_BASE_URL=http://localhost:8001

# Local client offline mode forces the mock service at http://localhost:8000.
TEMPER_OFFLINE=false

# Cloud offline mode uses scripted questions, scores, and patches.
CLOUD_OFFLINE=false

# Cloud service bind port. Deployment platforms may set PORT instead.
CLOUD_PORT=8001

# Public base URL embedded in Pi connection blocks.
# Uncomment for a deployed service. When unset, the server uses http://localhost:{CLOUD_PORT}.
# TEMPER_HOST_URL=https://temper.example.com
